generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Currency {
  code          String            @id @db.VarChar(3)
  name          String            @db.VarChar(80)
  symbol        String            @db.VarChar(8)
  minorUnit     Int               @default(2) @map("minor_unit") @db.SmallInt
  active        Boolean           @default(true)
  countries     CountryCurrency[]

  @@map("currencies")
}

model Country {
  code        String            @id @db.VarChar(2)
  name        String            @db.VarChar(100)
  phonePrefix String            @map("phone_prefix") @db.VarChar(8)
  active      Boolean           @default(false)
  currencies  CountryCurrency[]
  regions     Region[]

  @@map("countries")
}

model CountryCurrency {
  countryCode  String   @map("country_code") @db.VarChar(2)
  currencyCode String   @map("currency_code") @db.VarChar(3)
  isDefault    Boolean  @default(false) @map("is_default")
  country      Country  @relation(fields: [countryCode], references: [code])
  currency     Currency @relation(fields: [currencyCode], references: [code])

  @@id([countryCode, currencyCode])
  @@map("country_currencies")
}

model Region {
  id          String  @id @db.Char(26)
  countryCode String  @map("country_code") @db.VarChar(2)
  name        String  @db.VarChar(100)
  slug        String  @db.VarChar(100)
  country     Country @relation(fields: [countryCode], references: [code])
  cities      City[]

  @@unique([countryCode, slug])
  @@map("regions")
}

model City {
  id       String @id @db.Char(26)
  regionId String @map("region_id") @db.Char(26)
  name     String @db.VarChar(100)
  slug     String @db.VarChar(100)
  region   Region @relation(fields: [regionId], references: [id])

  @@unique([regionId, slug])
  @@map("cities")
}

model Department {
  id   String @id @db.Char(26)
  slug String @unique @db.VarChar(80)
  name String @db.VarChar(100)
  sort Int    @default(0)

  categories Category[]

  @@map("departments")
}

model Category {
  id           String     @id @db.Char(26)
  departmentId String     @map("department_id") @db.Char(26)
  slug         String     @unique @db.VarChar(80)
  name         String     @db.VarChar(100)
  sort         Int        @default(0)
  department   Department @relation(fields: [departmentId], references: [id])

  @@map("categories")
}

model AuditLog {
  id         String   @id @db.Char(26)
  actorId    String?  @map("actor_id") @db.Char(26)
  action     String   @db.VarChar(80)
  targetType String   @map("target_type") @db.VarChar(40)
  targetId   String   @map("target_id") @db.VarChar(40)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_log")
}
