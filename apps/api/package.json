    "fastify": "^5.2.1",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "ulid": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
