# Copier vers .env.local (local) et renseigner aussi dans Vercel → Settings → Environment Variables

# Public (navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Serveur uniquement — ne jamais préfixer NEXT_PUBLIC_
# Requis pour /api/orders et /api/seller-applications (RLS deny-by-default)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
