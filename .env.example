# Copier vers .env.local (local) et renseigner sur NitroHost

# Base PostgreSQL Neon (neon.tech)
# DATABASE_URL = Connection Pooling (avec -pooler) pour Next.js en production/serverless
DATABASE_URL="postgresql://[user]:[password]@[ep-xyz]-pooler.neon.tech/neondb?sslmode=require"
# DIRECT_URL = Connexion directe (sans pooler) pour les migrations Prisma (db push / migrate)
DIRECT_URL="postgresql://[user]:[password]@[ep-xyz].neon.tech/neondb?sslmode=require"

# Protection admin temporaire (optionnel)
ADMIN_ACCESS_TOKEN=change-me-admin

# Email (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=votre-compte@domaine.com
SMTP_PASS=votre-mot-de-passe
SMTP_FROM="Mwinda Market <noreply@mwinda.market>"
ADMIN_EMAIL=admin@mwinda.market

# WhatsApp Business API (optionnel)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Google Places & Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 (Connexion Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

